---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <MainCard
    title="About Rifky Awalul Huda"
    description="Hanya pegawai kantoran biasa yang kebetulan suka ngulik soal Teknologi dan perkembangannya"
    textOverlay="ABOUT"
    infoIcon="lucide:user"
  >
    <div class="space-y-10 mb-8">
      <!-- Profile Section -->
      <section class="flex flex-col md:flex-row gap-8 items-center md:items-start">
        <div class="avatar">
          <div
            class="w-32 h-32 md:w-40 md:h-40 rounded-xl ring ring-primary ring-offset-base-100 ring-offset-2 overflow-hidden"
          >
            <img src="https://github.com/rifkyawalulhuda.png" alt="rifkyawalulhuda" width="160" height="160" loading="eager" />
          </div>
        </div>

        <div class="flex-1 text-center md:text-left">
          <h1 class="text-3xl md:text-4xl font-bold mb-2">Rifky Awalul Huda</h1>
          <p class="text-xl text-base-content/80 mb-4">Karyawan Kantoran biasa nyambi IT</p>

          <div class="flex flex-wrap gap-3 justify-center md:justify-start mb-6">
            <a
              href="https://www.linkedin.com/in/rifky-awalul-huda-6b7a1a12a"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:linkedin" class="w-4 h-4" />
              <span>Linkedin</span>
            </a>
            <a
              href="https://www.facebook.com/rifky.leon"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:facebook" class="w-4 h-4" />
              <span>Facebook</span>
            </a>
            <a href="mailto:rifkyawalulhuda@gmail.com" class="btn btn-sm btn-outline gap-2">
              <Icon name="lucide:mail" class="w-4 h-4" />
              <span>Email</span>
            </a>
          </div>

          <p class="text-base-content/80">
            Hanya pegawai kantoran biasa yang kebetulan suka ngulik soal Teknologi dan perkembangannya.
            Di tengah rutinitas kerja yang padat, saya selalu menyempatkan waktu untuk mengikuti perkembangan teknologi — mulai dari AI, gadget, software, sampai tren digital yang sedang naik daun. Bukan ahli, tapi suka belajar dan berbagi hal-hal menarik seputar tech.
            Kalau kamu juga hobi ngulik teknologi atau punya insight seru, yuk connect dan ngobrol bareng!
          </p>
        </div>
      </section>

      <!-- GitHub Stats -->
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:github" class="w-6 h-6 text-primary" />
          <span>GitHub Statistics</span>
        </h2>

        <GitHubStats username="rifkyawalulhuda" showLanguages={false} showCommitGraph={true} />
      </section>

      <!-- Tech Stack -->
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:code-2" class="w-6 h-6 text-primary" />
          <span>Tech Stack</span>
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
          {
            [
              { name: "Astro", icon: "simple-icons:astro", color: "oklch(0.5 0.2 300)" },
              { name: "JavaScript", icon: "simple-icons:javascript", color: "oklch(0.8 0.2 80)" },
              { name: "Wordpress", icon: "simple-icons:wordpress", color: "oklch(0.6 0.2 250)" },
              { name: "React", icon: "simple-icons:react", color: "oklch(0.7 0.2 200)" },
              { name: "Node.js", icon: "simple-icons:nodedotjs", color: "oklch(0.7 0.2 140)" },
              { name: "TailwindCSS", icon: "simple-icons:tailwindcss", color: "oklch(0.6 0.2 220)" },
              { name: "HTML5", icon: "simple-icons:html5", color: "oklch(0.7 0.2 30)" },
              { name: "CSS3", icon: "simple-icons:css3", color: "oklch(0.7 0.2 220)" },
              { name: "Git", icon: "simple-icons:git", color: "oklch(0.7 0.2 30)" },
              { name: "Laravel", icon: "simple-icons:laravel", color: "oklch(0.6 0.2 240)" },
              { name: "Vue", icon: "simple-icons:vuedotjs", color: "oklch(0.6 0.2 160)" },
              { name: "Python", icon: "simple-icons:python", color: "oklch(0.7 0.2 250)" },
            ].map((tech) => (
              <div class="flex flex-col items-center justify-center p-4 bg-base-200 rounded-lg hover:bg-base-300 transition-colors">
                <div class="text-3xl mb-2" style={`color: ${tech.color}`}>
                  <Icon name={tech.icon} class="w-10 h-10" />
                </div>
                <span class="text-sm font-medium">{tech.name}</span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Contribution Activity -->
      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:activity" class="w-6 h-6 text-primary" />
          <span>Recent Activity</span>
        </h2>

        <div class="bg-base-200 rounded-xl p-6 overflow-x-auto">
          <div class="flex flex-col md:flex-row gap-8 md:gap-4 md:overflow-x-auto md:pb-2">
            {
              [
                {
                  date: "January 2022",
                  title: "Transport App Project",
                  desc: "Developed an application for sales, cost, transportation, and vehicle management.",
                },
                {
                  date: "September 2022",
                  title: "Create Company Profile",
                  desc: "Building a Company Profile Using WordPress CMS and cPanel.",
                },
                {
                  date: "July 2025",
                  title: "Warehouse Queue App Project",
                  desc: "Developed a trucking queue management system for loading and unloading operations at client warehouse.",
                },
                {
                  date: "October 2025",
                  title: "Computer Inventory App Project",
                  desc: "Developed a computer device management system accessible by designated personnel across client sites company.",
                },
                {
                  date: "January 2026",
                  title: "Employee Hub App Project",
                  desc: "Developed an employee management system covering leave requests, warning letters, counseling, and related workflows.",
                },
              ].map((item, i) => (
                <div class="relative flex gap-4 pb-2 md:pb-0 md:min-w-[250px]">
                  <div class="flex flex-col items-center">
                    <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-primary-content text-xl">
                      {i + 1}
                    </div>
                    <div class="w-0.5 h-16 bg-base-300 mt-2 md:hidden" />
                  </div>
                  <div>
                    <div class="text-sm text-base-content/60 mb-1">{item.date}</div>
                    <h3 class="text-lg font-bold">{item.title}</h3>
                    <p class="text-base-content/80 mt-1">{item.desc}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </MainCard>
</BaseLayout>

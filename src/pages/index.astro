---
import { Icon } from "astro-icon/components";
import { DATE_FORMAT } from "@config";
import MainCard from "@/components/MainCard.astro";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import dayjs from "@utils/dayjs";
import { getAllPosts, sortPostsByDate } from "@utils/blogUtils";

const latestPosts = sortPostsByDate(await getAllPosts()).slice(0, 6);
---

<BaseLayout title="Home">
  <MainCard
    title="Welcome to Ngopidulur"
    description="A modern, responsive, feature-rich blog theme for Astro with dark/light mode and customizable options."
    textOverlay="HOME"
    infoIcon="lucide:info"
  >
    <div class="space-y-8">
      <!-- Hero Section -->
      <section class="py-6">
        <div class="flex flex-col items-center text-center">
          <img
            src="/profile2.png"
            alt="Blog Ngopidulur"
            class="h-20 w-auto mb-4 object-contain"
          />
          <p class="text-xl text-base-content/80 max-w-3xl mb-8">
            Ini adalah blog pribadi dengan posting yang sangat random,
            jadi jangan terlalu serius....
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a href="/blog" class="btn btn-primary gap-2 btn-shine-effect">
              <Icon name="lucide:book-open" class="w-5 h-5" />
              <span>Explore Blog</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Latest Blog Section -->
      <section class="py-6">
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="text-2xl font-bold flex items-center gap-2">
              <Icon name="lucide:newspaper" class="w-6 h-6 text-primary" />
              <span>Blog Terbaru</span>
            </h2>
            <p class="mt-2 text-sm text-base-content/70">
              Enam tulisan paling baru dari Ngopidulur, siap buat dibaca santai.
            </p>
          </div>

          <a href="/blog" class="btn btn-outline btn-primary gap-2 self-start sm:self-auto">
            <span>Lihat Semua Post</span>
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </a>
        </div>

        {
          latestPosts.length > 0 ? (
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
              {latestPosts.map((blog) => (
                <a
                  href={`/blog/${blog.id}`}
                  class="group card min-h-[220px] border border-base-200 bg-base-100 shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
                >
                  <div class="card-body justify-between gap-5 p-6">
                    <div class="space-y-4">
                      <div class="flex items-start justify-between gap-3">
                        <div class="rounded-2xl bg-primary/10 p-3 text-primary transition-colors duration-300 group-hover:bg-primary group-hover:text-primary-content">
                          <Icon name="lucide:newspaper" class="h-5 w-5" />
                        </div>
                        {
                          blog.data.badge && (
                            <span class="badge badge-outline">{blog.data.badge}</span>
                          )
                        }
                      </div>

                      <div class="space-y-2">
                        <p class="text-xs font-medium uppercase tracking-[0.2em] text-base-content/50">
                          {dayjs(blog.data.pubDate).format(DATE_FORMAT)}
                        </p>
                        <h3 class="line-clamp-2 text-lg font-bold leading-snug text-base-content transition-colors duration-300 group-hover:text-primary">
                          {blog.data.title}
                        </h3>
                        <p class="line-clamp-3 text-sm leading-6 text-base-content/70">
                          {blog.data.description}
                        </p>
                      </div>
                    </div>

                    <div class="flex items-center justify-between gap-3 border-t border-dashed border-base-300 pt-4">
                      <span class="text-sm text-base-content/60">
                        {blog.data.categories?.[0] ?? "Artikel"}
                      </span>
                      <span class="inline-flex items-center gap-2 text-sm font-medium text-primary">
                        Baca Post
                        <Icon
                          name="lucide:arrow-right"
                          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                        />
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="card border border-dashed border-base-300 bg-base-100">
              <div class="card-body items-center py-10 text-center">
                <Icon name="lucide:file-text" class="w-10 h-10 text-base-content/40" />
                <h3 class="text-lg font-semibold">Belum ada post terbaru</h3>
                <p class="max-w-md text-sm text-base-content/70">
                  Begitu artikel pertama dipublikasikan, section ini akan otomatis menampilkannya di sini.
                </p>
              </div>
            </div>
          )
        }
      </section>

      <!-- GitHub Stats -->
      <section class="py-6">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:github" class="w-6 h-6 text-primary" />
          <span>Repository Stats</span>
        </h2>

        <GitHubStats username="rifkyawalulhuda" />
      </section>
    </div>
  </MainCard>
</BaseLayout>

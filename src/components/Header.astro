---
import "../styles/global.scss";
import "/node_modules/katex/dist/katex.min.css";
import type { HeaderProps } from "@interfaces/data";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, favicon, image } = Astro.props as HeaderProps;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image" href={favicon} />
<meta name="generator" content={Astro.generator} />

<!-- Performance: preconnect ke external resources -->
<link rel="preconnect" href="https://www.googletagmanager.com" />
<link rel="preconnect" href="https://www.google-analytics.com" />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="dns-prefetch" href="https://www.google-analytics.com" />

<!-- Preload LCP image jika ada -->
{image && <link rel="preload" as="image" href={image} fetchpriority="high" />}

<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={image} />}
<link rel="canonical" href={canonicalURL.toString()} />

---
import { t } from "@config";
import type { PaginationProps } from "@interfaces/data";
import PaginationArrow from "./PaginationArrow.astro";
import PaginationDropdown from "./PaginationDropdown.astro";
import PaginationNumber from "./PaginationNumber.astro";

const { page, totalPages, pageLinks, baseUrl } = Astro.props as PaginationProps;

const current = page.currentPage;
const startItem = page.start + 1;
const endItem = page.end + 1;

// Format helper — replace %d placeholders in order
function formatLabel(template: string, ...values: (string | number)[]): string {
  let i = 0;
  return template.replace(/%d/g, () => String(values[i++]));
}

const pageOfLabel = formatLabel(t("label.pageOf"), current, totalPages);
const showingLabel = formatLabel(t("label.showingPosts"), startItem, endItem, page.total);
---

<nav
  aria-label="Pagination"
  class="flex flex-col items-center w-full gap-3 order-4"
  transition:name="pagination"
>
  <!-- Page status info -->
  <div class="flex flex-col sm:flex-row items-center gap-1 sm:gap-3 text-xs sm:text-sm text-base-content/70 select-none">
    <span class="font-medium text-base-content/90">{pageOfLabel}</span>
    <span class="hidden sm:inline opacity-40">•</span>
    <span>{showingLabel}</span>
  </div>

  <!-- Controls -->
  <div class="flex items-center justify-between w-full gap-2">
    <PaginationArrow direction="prev" url={page.url.prev} label={t("label.prevPage")} />

    <div class="join">
      {totalPages > 3 ? (
        pageLinks.active.map((link: string | number) =>
          link === "..." ? (
            <PaginationDropdown
              hiddenPages={pageLinks.hidden}
              current={current}
              baseUrl={baseUrl}
            />
          ) : (
            <PaginationNumber number={link} current={current} baseUrl={baseUrl} />
          ),
        )
      ) : (
        pageLinks.active.map((link: string | number) => (
          <PaginationNumber
            number={link}
            current={current}
            baseUrl={baseUrl}
            isOnly={totalPages === 1}
          />
        ))
      )}
    </div>

    <PaginationArrow direction="next" url={page.url.next} label={t("label.nextPage")} />
  </div>
</nav>
